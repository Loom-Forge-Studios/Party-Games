{
  "name": "@party/game-codewords",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codewords (word-association clue game, generic non-trademarked name) — rules + presenter. Owned by A10 (Wave 2). module.ts/index.ts (rules) must not import Three.js; only presenter.ts may.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presenter": {
      "types": "./dist/presenter.d.ts",
      "default": "./dist/presenter.js"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@party/assets": "^0.1.0",
    "@party/engine": "*",
    "@party/presenter": "^0.1.0",
    "@party/protocol": "*",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4"
  }
}
