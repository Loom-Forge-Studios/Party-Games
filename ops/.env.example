# Copy this file to ops/.env and fill in your real domain:
#
#   cp ops/.env.example ops/.env
#
# docker compose auto-loads ops/.env (same directory as
# ops/docker-compose.yml) and substitutes it into ${DOMAIN} in
# ops/Caddyfile. See ops/DEPLOY.md for the full runbook.

# The domain your Ubuntu mini PC is reachable at, with a DNS A record
# pointed at its public IP. Caddy uses this both as the site it serves and
# to request a Let's Encrypt certificate for it — it must be a real,
# publicly resolvable domain, not "localhost" or a LAN hostname, or
# certificate issuance will fail.
DOMAIN=games.example.com
